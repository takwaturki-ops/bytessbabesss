# Copy to backend/.env and fill in real values. Never commit .env files.
# (The backend also reads <repo>/.env.local, the location used by the original Neon setup.)

PORT=4000

# Neon PostgreSQL connection string (from the Neon dashboard)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# REQUIRED: long random secret used to sign login tokens (the server refuses to start without it).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Token lifetime (jsonwebtoken format: 15m, 1h, 7d...)
JWT_EXPIRES_IN=15m

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# AI service (ai-services/, FastAPI). The key is sent server-side only (header X-API-Key);
# it must equal INTERNAL_API_KEY in ai-services/.env. Leave both empty for local development.
AI_SERVICE_URL=http://localhost:8001
INTERNAL_API_KEY=
AI_TIMEOUT_MS=20000

# LOCAL DEMO ONLY (no Neon credentials): in-memory PostgreSQL, schema + 12 courses loaded at startup,
# everything is lost when the server stops. Never use in production.
USE_IN_MEMORY_DB=false
# Optional demo admin created at startup in in-memory mode only (Neon: npm run create-admin -- email password name)
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_NAME=Admin 9antra

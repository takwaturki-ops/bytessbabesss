# Copy to .env and edit. Never commit .env (it is git-ignored).

# mock = no API calls, deterministic templated text labelled [MOCK] (default)
# live = real Claude calls (requires an API key below)
LLM_MODE=mock

# Model: sonnet (default, claude-sonnet-5-5) | haiku (cheapest, claude-haiku-5-5) | opus (upgrade, claude-opus-5-5)
LLM_MODEL=sonnet

# API key for live mode. LLM_API_KEY is the team name; ANTHROPIC_API_KEY also works.
# LLM_API_KEY=sk-ant-...

# Shared secret with the Node.js backend. When set, POST endpoints require header "X-API-Key".
# Leave empty for local development.
INTERNAL_API_KEY=

# Cost/latency controls
LLM_EFFORT=low
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_S=45
LLM_MAX_RETRIES=2

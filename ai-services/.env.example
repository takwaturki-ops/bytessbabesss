# Copy to .env and edit. Never commit .env (it is git-ignored).

# mock = no API calls, deterministic templated text labelled [MOCK] (default)
# live = real LLM calls (requires an API key below)
LLM_MODE=mock

# Live-mode provider: anthropic (default, Claude) | deepseek
LLM_PROVIDER=anthropic

# Model.
#   anthropic: sonnet (default, claude-sonnet-5-5) | haiku (cheapest, claude-haiku-5-5) | opus (claude-opus-5-5)
#   deepseek : deepseek-chat (default; a Claude alias here is replaced by deepseek-chat) | deepseek-reasoner
LLM_MODEL=sonnet

# API key for live mode.
#   anthropic: LLM_API_KEY (team name) or ANTHROPIC_API_KEY
#   deepseek : DEEPSEEK_API_KEY (LLM_API_KEY also works)
# LLM_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Shared secret with the Node.js backend. When set, POST endpoints require header "X-API-Key".
# Leave empty for local development.
INTERNAL_API_KEY=

# Cost/latency controls
LLM_EFFORT=low
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_S=45
LLM_MAX_RETRIES=2

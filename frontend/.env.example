# Copy to frontend/.env (never commit it). Vite exposes only variables starting with VITE_ to the browser:
# never put secrets here.
#
# Leave empty in development: the app and the API share one URL (http://localhost:5173).
# The Vite dev server forwards /api/* to the backend (BACKEND_URL, default http://localhost:4000).
# Set it only when the API is on another origin, e.g. a deployed backend.
VITE_API_BASE_URL=
